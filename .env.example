# ==========================================
# Environment Variables Configuration
# ==========================================
# Duplicate this file as `.env` and insert your actual API keys.

# Unsplash API Access Key (Required for Photo Search)
# Get your key at: https://unsplash.com/developers
VITE_UNSPLASH_KEY=your_unsplash_access_key_here

# Pexels API Key (Required for Video Search)
# Get your key at: https://www.pexels.com/api/
VITE_PEXELS_KEY=your_pexels_api_key_here
